<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Instrument Types</title>
</head>
<body>

    <h2>Types of <%= instrumentName %></h2>

    <ul>
        <% locals.instruments.forEach((instrument) => { %>
            <li>
                <span><%= instrument %></span>
                <div>
                    <form  action="/<%= instrumentName %>s/delete/<%= instrument %>" method="post">
                        <input type="hidden" name="_method" value="delete">
                        <button type="submit">Delete</button>
                        
                    </form>
                    <form action="/<%= instrumentName %>s/update/<%= instrument %>?_method=PUT" method="POST">
  <input type="text" name="newName" placeholder="Enter new name" id="instrumentName">
  <button type="submit">Update</button>
</form>
                    
                </div>
            </li>
        <% }) %>
    </ul>
   <form action="/<%= instrumentName %>s/add" method="POST">
  <input type="text" name="typeName" placeholder="Enter type name">
  <button type="submit">Add <%= instrumentName %> type</button>
</form>
    


</body>
</html>
