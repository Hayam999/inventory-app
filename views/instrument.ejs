<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Instrument Types</title>
</head>
<body>

    <h2>Types of <%= instrumentName %></h2>

    <ul>
        <% locals.instruments.forEach((instrument) => { %>
            <li>
                <span><%= instrument %></span>
                <div>
                    <button type="button" onclick="deleteIns('<%= instrument %>')">
                        Delete
                    </button>
                    <button type="button" onclick="updateIns('<%= instrument %>')">
                        Update
                    </button>
                </div>
            </li>
        <% }) %>
    </ul>

    <button type="button" onclick="addIns('<%= instrumentName %>')">
        Add <%= instrumentName %> type
    </button>


</body>
</html>
